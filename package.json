{
  "name": "roomflow",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun tsc -b && bunx --bun vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell": "cspell --no-progress --gitignore \"src/**\" \"docs/**\" \".github/**\" \"*.{md,html,ts,js}\" package.json \"tsconfig*.json\" components.json wrangler.jsonc",
    "typecheck": "bunx --bun tsc -b",
    "preview": "bunx --bun vite preview",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hookform/resolvers": "^5.5.7",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.83.0",
    "react-router": "^8.3.0",
    "recharts": "3.8.0",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "cspell": "^10.0.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "msw": "^2.15.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "wrangler": "^4.151.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
